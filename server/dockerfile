# --- Stage 1: Build Stage ---
# ใช้สำหรับ build C++ addons และ transpile TypeScript
FROM node:20-alpine AS builder

RUN apk upgrade --no-cache

WORKDIR /usr/src/app

# ติดตั้ง dependencies สำหรับ build C++ addons (เหมือนเดิม)
RUN apk add --no-cache \
    python3 \
    make \
    g++ \
    vips-dev \
    libusb-dev \
    iputils \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    musl-dev \
    giflib-dev \
    pixman-dev \
    pangomm-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    fontconfig \
    ttf-liberation

# คัดลอก package.json และติดตั้ง dependencies
COPY package*.json ./
RUN npm install && npm cache clean --force

# คัดลอก source code ที่เหลือ
COPY . .

# Build NestJS app
RUN npm run build

# --- Stage 2: Production Stage ---
# Image สุดท้ายที่จะนำไปใช้งานจริง
FROM node:20-alpine

RUN apk upgrade --no-cache

WORKDIR /usr/src/app

# ติดตั้ง *เฉพาะ* dependencies ที่จำเป็นตอนรัน (เหมือนเดิม)
# (สังเกตว่าเราใช้ vips, libusb ไม่ใช่ ...-dev)
RUN apk add --no-cache \
    vips \
    libusb \
    iputils \
    cairo \
    jpeg \
    pango \
    musl \
    giflib \
    pixman \
    pangomm \
    libjpeg-turbo \
    freetype \
    fontconfig \
    ttf-liberation

# อัปเดต font cache (เหมือนเดิม)
RUN fc-cache -f -v

# คัดลอก package.json (สำหรับ start:prod)
COPY package*.json ./

# --- !!! ส่วนที่เปลี่ยนแปลง (อีกครั้ง) !!! ---
#
# เราต้องเพิ่ม dev libraries ทั้งหมดที่จำเป็นต่อการ compile
# เข้าไปใน .build-deps (กลุ่มที่จะติดตั้งชั่วคราว) ด้วย
#
RUN apk add --no-cache --virtual .build-deps \
    python3 \
    make \
    g++ \
    vips-dev \
    libusb-dev \
    cairo-dev \
    jpeg-dev \
    pango-dev \
    musl-dev \
    giflib-dev \
    pixman-dev \
    pangomm-dev \
    libjpeg-turbo-dev \
    freetype-dev \
    && npm install --omit=dev \
    && apk del .build-deps \
    && npm cache clean --force

# คัดลอก NestJS app ที่ build เสร็จแล้ว (โฟลเดอร์ dist) จาก stage 1
COPY --from=builder /usr/src/app/dist ./dist
#
# --- จบส่วนที่เปลี่ยนแปลง ---

# Expose port
EXPOSE 3000

# Command to run the application (ใช้ path ที่แก้แล้ว)
CMD ["node", "dist/src/main.js"]